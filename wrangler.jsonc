{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "entheai",
	"compatibility_date": "2026-07-18",
	// Roadmap 4.1: the Worker serves /api/entropy (live beacon) in front of the
	// static assets. Until the KV binding below is provisioned + uncommented the
	// endpoint answers 503 {"error":"entropy store unbound"} — deploys never
	// break. One-time setup:
	//   wrangler kv namespace create ENTROPY      → paste the id below, uncomment
	//   wrangler secret put ENTROPY_TOKEN         → the bridge's bearer token
	"main": "src/worker.mjs",
	"kv_namespaces": [
		// ENTROPY (live beacon) — commented until provisioned:
		//   wrangler kv namespace create ENTROPY → paste the id below, uncomment.
		// { "binding": "ENTROPY", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
		// LICENSES (backer licenses: license:<key>, session:<checkout id>,
		// releases:<channel>). Real namespace id below (provisioned via
		// `wrangler kv namespace create LICENSES`).
		{
			"binding": "LICENSES",
			"id": "b2f96c12b41242138d46d863ad30bd6a"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Static assets are served BEFORE the Worker by default, so a bare "/"
		// matched index.html directly and the Worker's gallery.entheai.com host
		// rewrite (src/worker.mjs) never ran — the subdomain root showed the
		// homepage instead of the gallery. Run the Worker first for the ROOT ONLY
		// (NOT /gallery — that's served directly by the assets pretty-URL handler;
		// running the Worker for it would rewrite → /gallery.html → 307 → /gallery
		// → a redirect loop). Every other asset still serves directly from the edge.
		// The /api/* routes (entropy beacon + Stripe webhook + license endpoints)
		// must also run the Worker first — there are no static assets under /api/,
		// and without this the assets pipeline 404s/405s them before the Worker sees
		// them.
		"run_worker_first": [
			"/",
			"/api/*",
			"/.well-known/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "entheai.com",
			"custom_domain": true
		},
		{
			"pattern": "www.entheai.com",
			"custom_domain": true
		},
		{
			"pattern": "gallery.entheai.com",
			"custom_domain": true
		}
	]
}