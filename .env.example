# Copy to `.env` and fill in your keys. `.env` is gitignored — never commit real keys.
# entheai loads this file at startup (via dotenvy); values are read per provider's api_key_env.
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# Valyu deep-search MCP: full remote URL including ?valyuApiKey=... (used by [mcp.valyu])
VALYU_MCP_URL=

# tantra-agent (crates/tantra-agent): the three board collaborators' GitHub
# tokens for the tantric board (peterlodri-sec/mlxquantlovefrom.com). Only
# these three accounts have write access — each collaborator exports their own.
TANTRIC_TOKEN_PETER=
TANTRIC_TOKEN_8BIT=
TANTRIC_TOKEN_SG=

# tantra-agent model overrides (defaults: https://coder.vaked.dev/v1, qwen3-coder:30b)
# TANTRIC_MODEL_URL=
# TANTRIC_MODEL_NAME=
# TANTRIC_MODEL_API_KEY=
